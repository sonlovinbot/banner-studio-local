# Sao chép file này thành .env.local rồi điền key. Mọi dòng đều KHÔNG bắt buộc —
# app chạy được ngay khi chưa có key nào, chỉ là chưa sinh được ảnh.
#
#   cp .env.example .env.local

# ───────── Sinh ảnh ─────────

# Coachio — backend chính của Banner Tool và UGC Studio.
# Lấy ở: https://studio.coachio.ai
# Có thể nhập trong app ở Settings → API Keys thay vì đặt ở đây.
VITE_COACHIO_API_KEY=

# OpenAI — dùng cho tier 2K/4K và làm phương án dự phòng khi Coachio lỗi.
# Lấy ở: https://platform.openai.com/api-keys
VITE_OPENAI_API_KEY=

# KIE.ai — một key chạy được nhiều model (Nano Banana, Veo, Suno).
# Lấy ở: https://kie.ai/api-key
# Front-end gọi KIE qua server local nên key ĐỌC Ở PHÍA SERVER, không có VITE_.
KIE_API_KEY=

# Google Gemini — backend phụ, không bắt buộc.
# Lấy ở: https://aistudio.google.com/apikey
VITE_GEMINI_API_KEY=

# ───────── Lấy nội dung từ web ─────────

# Firecrawl — biến một URL thành markdown cho chức năng URL Import ở Brand Style.
# Lấy ở: https://firecrawl.dev/app/api-keys
# Cũng đọc ở phía server (Firecrawl không cho trình duyệt gọi trực tiếp).
FIRECRAWL_API_KEY=

# ───────── Supabase (hoàn toàn không bắt buộc) ─────────

# Để TRỐNG thì app chạy local: dữ liệu nằm trong ./data/app.db.
# Điền cả hai dòng thì app tự chuyển sang Supabase thật, không cần sửa code.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# ───────── Cổng ─────────

# Cổng của server local (API + DB). Giao diện chạy ở 3100.
PORT=5174
